default_platform(:ios)

platform :ios do
  # `flutter build ipa` embeds entitlements (aps-environment, Sign in with
  # Apple, etc) into the app bundle DURING codesigning at archive time — that
  # only happens if the archive step itself signs the app. A previous version
  # of this pipeline archived with `--no-codesign` (to dodge Automatic signing
  # needing an interactive Apple ID session in CI) and re-signed afterward via
  # `build_app`'s `-exportArchive`. That re-sign step does NOT re-read
  # CODE_SIGN_ENTITLEMENTS from the Xcode project or re-derive entitlements
  # from the provisioning profile — it just re-signs whatever entitlements
  # state the archive already has, which for an unsigned archive is
  # effectively nothing. The result was a shipped TestFlight binary with only
  # the bare-minimum entitlements (bundle/team identifier, beta flag),
  # silently missing Push Notifications and Sign in with Apple, with no error
  # anywhere in the CI logs.
  #
  # Fix: `prepare_signing` installs the cert + provisioning profile into a CI
  # keychain BEFORE `flutter build ipa` runs (as its own workflow step, no
  # --no-codesign), so the archive step itself signs correctly using Manual
  # signing (see CODE_SIGN_STYLE/PROVISIONING_PROFILE_SPECIFIER on the
  # Runner target's Release config) and entitlements get embedded for real.
  # `testflight` then just uploads the already-signed IPA.
  desc "Install the distribution cert + provisioning profile into a CI keychain, ahead of `flutter build ipa`"
  lane :prepare_signing do
    # Fixed (not timestamped) name: `flutter build ipa` runs as a separate,
    # later workflow step outside fastlane's process, so the exact keychain
    # name has to be predictable to reference it there (as the default
    # keychain) rather than passed via fastlane's in-memory lane_context.
    keychain_name = "tulink-ci.keychain-db"
    keychain_password = ENV["IOS_KEYCHAIN_PASSWORD"] ||
      UI.user_error!("IOS_KEYCHAIN_PASSWORD not set")
    cert_path = ENV["IOS_CERT_PATH"] ||
      UI.user_error!("IOS_CERT_PATH not set (path to .p12)")
    cert_password = ENV["IOS_CERT_PASSWORD"] ||
      UI.user_error!("IOS_CERT_PASSWORD not set")
    profile_path = ENV["IOS_PROVISIONING_PROFILE_PATH"] ||
      UI.user_error!("IOS_PROVISIONING_PROFILE_PATH not set")

    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false,
      add_to_search_list: true,
    )

    import_certificate(
      certificate_path: cert_path,
      certificate_password: cert_password,
      keychain_name: keychain_name,
      keychain_password: keychain_password,
    )

    install_provisioning_profile(path: profile_path)
  end

  desc "Upload an already-built, already-signed IPA to TestFlight"
  lane :testflight do
    ipa_path = ENV["IOS_IPA_PATH"] ||
      UI.user_error!("IOS_IPA_PATH not set (path to the signed .ipa)")
    api_key_path = ENV["APP_STORE_CONNECT_API_KEY_PATH"] ||
      UI.user_error!("APP_STORE_CONNECT_API_KEY_PATH not set (path to .p8)")
    api_key_id = ENV["APP_STORE_CONNECT_API_KEY_ID"] ||
      UI.user_error!("APP_STORE_CONNECT_API_KEY_ID not set")
    api_issuer_id = ENV["APP_STORE_CONNECT_API_ISSUER_ID"] ||
      UI.user_error!("APP_STORE_CONNECT_API_ISSUER_ID not set")

    api_key = app_store_connect_api_key(
      key_id: api_key_id,
      issuer_id: api_issuer_id,
      key_filepath: api_key_path,
      duration: 500,
      in_house: false,
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      distribute_external: false,
    )
  end

  desc "Delete the CI keychain created by prepare_signing"
  lane :cleanup_signing do
    delete_keychain(name: "tulink-ci.keychain-db") rescue nil
  end

  # DEPRECATED: superseded by the :testflight lane below. Kept as a working ad-hoc/Firebase fallback; not wired into any CI workflow.
  desc "Build an Ad Hoc IPA and distribute to Firebase App Distribution"
  lane :beta do
    firebase_app_id = ENV["FIREBASE_IOS_APP_ID"] ||
      UI.user_error!("FIREBASE_IOS_APP_ID not set")
    service_account_path = ENV["FIREBASE_SERVICE_ACCOUNT_PATH"] ||
      UI.user_error!("FIREBASE_SERVICE_ACCOUNT_PATH not set")
    release_notes = ENV["RELEASE_NOTES"] || `git log -1 --pretty=%B`.strip
    groups = ENV["FAD_GROUPS"] || "tulink-alpha-testers"

    # Unique name prevents collisions when jobs run concurrently on the same host.
    keychain_name = "tulink-ci-#{Time.now.to_i}"
    keychain_password = ENV["IOS_KEYCHAIN_PASSWORD"] ||
      UI.user_error!("IOS_KEYCHAIN_PASSWORD not set")
    cert_path = ENV["IOS_CERT_PATH"] ||
      UI.user_error!("IOS_CERT_PATH not set (path to .p12)")
    cert_password = ENV["IOS_CERT_PASSWORD"] ||
      UI.user_error!("IOS_CERT_PASSWORD not set")
    profile_path = ENV["IOS_PROVISIONING_PROFILE_PATH"] ||
      UI.user_error!("IOS_PROVISIONING_PROFILE_PATH not set")
    profile_name = ENV["IOS_PROVISIONING_PROFILE_NAME"] ||
      UI.user_error!("IOS_PROVISIONING_PROFILE_NAME not set")

    begin
      create_keychain(
        name: keychain_name,
        password: keychain_password,
        default_keychain: false,
        unlock: true,
        timeout: 3600,
        lock_when_sleeps: false,
      )

      import_certificate(
        certificate_path: cert_path,
        certificate_password: cert_password,
        keychain_name: keychain_name,
        keychain_password: keychain_password,
      )

      install_provisioning_profile(path: profile_path)

      # flutter build ipa --no-codesign produces the .xcarchive; gym re-signs it.
      build_app(
        workspace: "Runner.xcworkspace",
        scheme: "Runner",
        configuration: "Release",
        export_method: "ad-hoc",
        skip_build_archive: true,
        archive_path: "../build/ios/archive/Runner.xcarchive",
        export_options: {
          signingStyle: "manual",
          provisioningProfiles: {
            "xyz.tulink.app" => profile_name,
          },
        },
        output_directory: "../build/ios/ipa",
        output_name: "Runner.ipa",
      )

      firebase_app_distribution(
        app: firebase_app_id,
        ipa_path: "../build/ios/ipa/Runner.ipa",
        service_credentials_file: service_account_path,
        groups: groups,
        release_notes: release_notes,
      )
    ensure
      delete_keychain(name: keychain_name) rescue nil
    end
  end

  desc "Production release to App Store (NOT IMPLEMENTED YET)"
  lane :production do
    UI.user_error!(
      "iOS production lane is not implemented yet. " \
      "This batch is beta-only. Wire up `deliver` (App Store Connect) or " \
      "`pilot` (TestFlight) in a future PR.",
    )
  end
end
