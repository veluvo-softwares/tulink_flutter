default_platform(:android)

platform :android do
  desc "Build a release APK and distribute to Firebase App Distribution"
  lane :beta do
    firebase_app_id = ENV["FIREBASE_ANDROID_APP_ID"] ||
      UI.user_error!("FIREBASE_ANDROID_APP_ID not set")
    service_account_path = ENV["FIREBASE_SERVICE_ACCOUNT_PATH"] ||
      UI.user_error!("FIREBASE_SERVICE_ACCOUNT_PATH not set")
    release_notes = ENV["RELEASE_NOTES"] || `git log -1 --pretty=%B`.strip
    groups = ENV["FAD_GROUPS"] || "tulink-alpha-testers"

    apk_path = ENV["APK_PATH"] || "../build/app/outputs/flutter-apk/app-release.apk"
    UI.user_error!("APK not found at #{apk_path}") unless File.exist?(apk_path)

    firebase_app_distribution(
      app: firebase_app_id,
      android_artifact_type: "APK",
      android_artifact_path: apk_path,
      service_credentials_file: service_account_path,
      groups: groups,
      release_notes: release_notes,
    )
  end

  desc "Production release to Play Store (NOT IMPLEMENTED YET)"
  lane :production do
    UI.user_error!(
      "Android production lane is not implemented yet. " \
      "This batch is beta-only. Wire up `supply` (Play Store API) and a " \
      "production track in a future PR.",
    )
  end
end
